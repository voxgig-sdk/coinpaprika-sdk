# Entity: coin

main: kit: entity: coin: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      short: "Unique identifier for the coin"
      type: "`$STRING`"
    }
    {
      name: "is_active"
      req: false
      short: "Indicates if the coin is active"
      type: "`$BOOLEAN`"
    }
    {
      name: "is_new"
      req: false
      short: "Indicates if the coin is new"
      type: "`$BOOLEAN`"
    }
    {
      name: "name"
      req: false
      short: "Name of the cryptocurrency"
      type: "`$STRING`"
    }
    {
      name: "rank"
      req: false
      short: "Market cap rank"
      type: "`$INTEGER`"
    }
    {
      name: "symbol"
      req: false
      short: "Ticker symbol of the cryptocurrency"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of cryptocurrency (coin or token)"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "coin"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/coins"
          segments: [
            {
              lit: "coins"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
